import java.util.Arrays;

class Solution {
    public int[] twoSum(int[] nums, int target) {
        int n = nums.length;
        int left = 0;
        int right = n - 1;
        int sum = 0;
        

        int[][] res = new int[n][2];
        for (int i = 0; i < n; i++) {
            res[i][0] = nums[i]; 
            res[i][1] = i;      
        }
        
       
        Arrays.sort(nums);

       
        while (left < right) {
           
            sum = res[left][0] + res[right][0];
            
            if (sum == target) {
              
                return new int[] { res[left][1], res[right][1] };
            } 
            else if (sum > target) {
                right--;
            } 
            else {
                left++;
            }
        }

        return new int[] {};
    }
}
